<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore" />
        <include domain="sharedpref" path="." />
        <exclude domain="database" path="dictionary.sqlite" />
        <exclude domain="database" path="dictionary.sqlite-journal" />
        <exclude domain="sharedpref" path="dictionary_db.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore" />
        <include domain="sharedpref" path="." />
        <exclude domain="database" path="dictionary.sqlite" />
        <exclude domain="database" path="dictionary.sqlite-journal" />
        <exclude domain="sharedpref" path="dictionary_db.xml" />
    </device-transfer>
</data-extraction-rules>
