    <string name="grammar_pat_ezafe_title">Ezafe: -и</string>
    <string name="grammar_pat_ezafe_ex">хонаи калон (big house), китоби ман (my book)</string>
    <string name="grammar_pat_obj_title">Object marker: -ро</string>
    <string name="grammar_pat_obj_ex">Дарро пӯшед. (Close the door.)</string>
    <string name="grammar_pat_pres_title">Present tense: ме- + stem + ending</string>
    <string name="grammar_pat_pres_ex">рафтан → меравам (I go / am going)</string>

