    <string name="grammar_letter_gh_desc">voiced uvular fricative (like French r): ғамгин</string>
    <string name="grammar_letter_i_desc">stressed long i at word ends: бинӣ, зиндагӣ</string>
    <string name="grammar_letter_q_desc">deep uvular k from back of throat: қалам, вақт</string>
    <string name="grammar_letter_u_desc">rounded mid vowel: хӯрдан, кӯҳ, дӯст</string>
    <string name="grammar_letter_h_desc">soft breathy h (not guttural х): ҳафта, шаҳр</string>
    <string name="grammar_letter_j_desc">English j in \'jam\': ҷавоб, куҷо</string>
